# Environment Variables Template for SKM Luxury Bridal Studio
# DO NOT commit actual credentials or secrets to version control.

# Database Configuration
MONGODB_URI="mongodb://localhost:27017/skm_luxury_bridal"

# NextAuth.js Configuration
AUTH_SECRET="generate-a-secure-random-32-character-secret"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Configuration (Server-Side Secret Keys)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Public Site URL for Canonical SEO & OpenGraph Metadata
NEXT_PUBLIC_SITE_URL="https://skmluxurybridal.com"
