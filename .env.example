# Environment Variables Template for SKM Luxury Bridal Studio
# DO NOT commit actual credentials or secrets to version control.

# ============================================================
# DATABASE CONFIGURATION — READ THIS CAREFULLY
# ============================================================
#
# The MONGODB_URI determines WHICH database is used in each environment.
# The database name is embedded in the URI after the last "/" before "?".
#
# PRODUCTION  (Vercel → Environment Variables → "Production" scope):
#   MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/skm_bridal_prod"
#   ↑ "skm_bridal_prod" is the PRODUCTION database.
#   All bookings submitted on skm-luxury-bridal.vercel.app go here.
#   Your live admin (vercel.app/admin) reads from THIS database.
#
# LOCAL DEV  (.env.local on your machine):
#   MONGODB_URI="mongodb://localhost:27017/skm_bridal_dev"
#   ↑ "skm_bridal_dev" is the LOCAL dev database.
#   Bookings submitted on localhost:3000 go here.
#   Local admin (localhost:3000/admin) reads from THIS database.
#
# IMPORTANT: If you want your LOCAL admin to manage PRODUCTION data,
# set your .env.local to the same Atlas URI as the Vercel Production scope.
# Never use the same DB name for dev and prod — dev tests will pollute live data.
#
# COMMON MISTAKE THAT CAUSES "bookings submitted on prod don't appear locally":
#   - Your .env.local points to localhost MongoDB (different DB entirely)
#   - Data written on production goes to Atlas (prod DB)
#   - Local admin reads local MongoDB (dev DB) → sees nothing from prod
#   Solution: Point local admin to Atlas prod URI only when you explicitly
#             need to manage production data. Use separate dev URI otherwise.
# ============================================================

MONGODB_URI="mongodb://localhost:27017/skm_bridal_dev"

# NextAuth.js & Admin Credentials
AUTH_SECRET="generate-a-secure-random-32-character-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourSecureProductionPassword2026!"

# Cloudinary Configuration (Optional Server-Side Secret Keys)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Public Configuration & UPI Settings
NEXT_PUBLIC_SITE_URL="https://skm-luxury-bridal.vercel.app"
NEXT_PUBLIC_STUDIO_UPI_VPA="8608194233@upi"
NEXT_PUBLIC_GA_ID="G-SKMBRIDAL26"

